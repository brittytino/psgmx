# ─── PSGMX Flutter App — Environment Variables ───────────────────────────────
# Copy this file to .env.flutter (gitignored) and fill in real values.
# Usage: flutter run --dart-define-from-file=.env.flutter
#        flutter build apk --dart-define-from-file=.env.flutter
#
# NEVER commit .env.flutter to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Settings → API → anon public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Trusted PSGMX web API. Never place service-role keys, AI provider keys,
# email keys, shared integration secrets, or other server credentials here.
APP_API_URL=https://www.psgmx.tech
