NEXT_PUBLIC_APP_URL=https://app.psgmx.tech
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your-openrouter-key
RESEND_API_KEY=your-resend-key
CRON_SECRET=your-cron-secret
ECAMPUS_API_URL=https://your-ecampus-api.example.com
ECAMPUS_API_SECRET=server-only-shared-secret
# Optional: speech-to-text for the communication-practice grader.
# Without these, POST /api/communication/evaluate returns 503.
HUGGINGFACE_API_KEY=your-huggingface-key
STT_API_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3-turbo
# Local/test only. Enables a fixed OTP (098765) for the hardcoded staff roster
# in lib/staff-auth.ts. NEVER set this to true on a public production deployment
# — it is a full authentication bypass for every listed @psgtech.ac.in address.
ALLOW_STATIC_OTP=false
